{
  "name": "taskare-booking",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "BOOKINGS", "class_name": "BookingStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BookingStore"] }],
  "observability": { "enabled": false },
  "vars": {
    "ENABLED": "false",
    "FREE_PLAN_CONFIRMED": "false",
    "APP_URL": "https://example.invalid/task-calendar/",
    "PUBLIC_URL": "https://example.invalid",
    "OWNER_UID": "",
    "FIREBASE_API_KEY": "",
    "GOOGLE_CLIENT_ID": ""
  }
}
