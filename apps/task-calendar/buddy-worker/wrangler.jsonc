{
  "name": "taskare-buddy",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "BUDDY", "class_name": "BuddyQuota" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BuddyQuota"] }],
  "observability": { "enabled": false },
  "vars": {
    "ENABLED": "false",
    "FREE_PLAN_CONFIRMED": "false",
    "APP_ORIGIN": "https://taskare.pages.dev"
  }
}
