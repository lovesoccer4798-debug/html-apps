{
  "name": "taskare-reminders",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "kv_namespaces": [{ "binding": "REMINDERS", "id": "REPLACE_WITH_KV_ID" }],
  "triggers": { "crons": ["0,15,30,45 0 * * *"] },
  "vars": {
    "ALLOW_ORIGIN": "https://lovesoccer4798-debug.github.io",
    "VAPID_SUBJECT": "mailto:REPLACE_WITH_YOUR_EMAIL"
  }
}
